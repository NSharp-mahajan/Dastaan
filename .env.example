# Frontend Environment Variables
# Base URL for the Express API backend
VITE_API_BASE_URL=http://localhost:5000/api

# Firebase Web App Configuration (Firebase Console > Project settings > General > Your apps)
# Copy these from the Firebase SDK configuration for the project's Web app.
