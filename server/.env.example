# Dastaan Backend Configuration
# Port on which the Express server listens (default: 5000)
PORT=5000

# Client origin for CORS (React development frontend)
CLIENT_URL=http://localhost:3000

# MongoDB Connection URI (Local or MongoDB Atlas)
# Example local: mongodb://localhost:27017/dastaan
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/dastaan?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/dastaan

# Node Environment
NODE_ENV=development
