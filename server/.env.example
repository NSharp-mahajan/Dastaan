# Dastaan Backend Configuration
# Port on which the Express server listens (default: 5000)
PORT=5000

# Client origin for CORS (React development frontend)
CLIENT_URL=http://localhost:3000

# MongoDB Connection URI (Local or MongoDB Atlas)
# Example local: mongodb://localhost:27017/dastaan
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/dastaan?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/dastaan

# Node Environment
NODE_ENV=development

# Firebase Admin Configuration
FIREBASE_PROJECT_ID=dastaan-32c4e-249d1
# Optional: path to service account key file for privileged server-side operations
# GOOGLE_APPLICATION_CREDENTIALS=path/to/serviceAccountKey.json

# -----------------------------------------------------------------------------
# DASTAAN V2 — EXTERNAL TRAVEL DATA PROVIDERS (STAGE 1 & STAGE 2)
# -----------------------------------------------------------------------------

# Weather Provider: Open-Meteo
# Completely zero-config, free tier requires NO API KEY and NO BILLING.
# Live global forecasts are enabled automatically out of the box.

# Destination Geocoding: Open-Meteo Geocoding API
# Completely zero-config, free tier requires NO API KEY and NO BILLING.
# Live global city autocomplete is enabled automatically out of the box.

# Geographic Routing Engine:
# Default: OSRM (Open Source Routing Machine) public demo server.
# Free & zero-config for testing and evaluation (driving/walking road network routing).
# Terms of use note: The public demo server (router.project-osrm.org) is rate-limited and has no SLA.
# For high-volume production deployments, host a private OSRM Docker container locally.
# Optional override URL for private/self-hosted OSRM instance:
# OSRM_API_URL=http://localhost:5001

# Places Providers (Attractions & Restaurants):
# 1. Google Places API (New):
#    Sign up at https://console.cloud.google.com/
#    Enable "Places API (New)" and create an API Key.
#    $200 free monthly credit included automatically with Google Cloud Platform.
# GOOGLE_MAPS_API_KEY=AIzaSyYourGooglePlacesAPIKeyHere

# 2. Foursquare Places API (v3):
#    Sign up at https://foursquare.com/developers/
#    Free tier includes 10,000 queries per month.
# FOURSQUARE_API_KEY=fsq3YourFoursquareAPIKeyHere

# 3. OpenTripMap API:
#    Sign up at https://opentripmap.io/
#    Free tier includes 5,000 requests/day at up to 10 req/s.
# OPENTRIPMAP_API_KEY=5ae2e3f221c38a28845f05b6...

# Offline Fallback Mode:
# When external place keys are not configured, Dastaan automatically activates its
# verified Curated Offline Places Catalog, honestly tagged as source: 'curated-catalog'.

# Cache configuration (MongoDB TravelCache TTL in days, default: 14)
CACHE_TTL_DAYS=14
# NVIDIA NIM LLM Configuration (Backend Only - Never expose to client)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct
NVIDIA_TEMPERATURE=0.2
NVIDIA_MAX_TOKENS=512
NVIDIA_TIMEOUT_MS=10000
NVIDIA_CHAT_TIMEOUT_MS=10000
NVIDIA_CHAT_MAX_TOKENS=220

# OpenStreetMap / Overpass Grounding Configuration
# Optional: Dedicated or self-hosted Overpass interpreter URL (takes precedence over public mirrors)
# OVERPASS_HOSTED_URL=https://overpass.kumi.systems/api/interpreter
# Optional: API key / token for hosted Overpass services (sent as Bearer token header)
# OVERPASS_API_KEY=
# Optional: Comma-separated list of fallback Overpass mirrors
# OVERPASS_ENDPOINTS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter
